# Environment for the marketing site (apps/landing, port 4003).
# Copy to .env.local for local development, and mirror these in the landing
# project's Vercel environment variables for production.

# ── Analytics (optional) ────────────────────────────────────────────────────
# Client-side PostHog. Safe to expose; these are public project keys.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Meta pixel id (optional).
NEXT_PUBLIC_META_PIXEL_ID=

# ── Education access requests (/education) ──────────────────────────────────
# REQUIRED for the /education request form to work. Without it the intake route
# returns 500 and every lead falls back to a mailto:, which loses attribution.
# Same Resend key the main app uses; the sending domain must be verified.
RESEND_API_KEY=

# Where education leads are delivered. Defaults to support@veritio.io.
EDU_REQUEST_INBOX=

# Sender identity, in Resend's "Name <address>" format.
# Defaults to `Veritio <noreply@veritio.io>`. Mirrors EMAIL_FROM in apps/veritio.
EMAIL_FROM=

# Override the form's POST target, e.g. to point at a CRM or catch hook instead
# of the built-in /api/education-request route. Leave unset to use the route.
NEXT_PUBLIC_EDU_FORM_ENDPOINT=

# Durable copy of each lead, so a mail outage cannot lose one. Optional: without
# these the route still emails, it just has no queryable record.
#
# Deliberately NOT prefixed NEXT_PUBLIC_ — the key is used server-side only and
# must stay out of the client bundle. The anon key is safe here regardless: RLS
# on education_access_requests grants INSERT and nothing else, so it cannot read
# a single stored lead. Do NOT put the service role key on this project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
