FROM oven/bun:1.3-slim

WORKDIR /app

# Copy Yjs server files
COPY apps/veritio/scripts/yjs-server/package.json ./

# Install Yjs server dependencies
RUN bun install

# Copy server source (now self-contained — includes its own yjs-token.ts
# verifier so module resolution stays inside this directory tree)
COPY apps/veritio/scripts/yjs-server/ ./

EXPOSE 4002

CMD ["bun", "run", "server.ts"]
