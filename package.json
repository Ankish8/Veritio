{
  "name": "veritio-monorepo",
  "version": "0.1.0",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/@veritio/*",
    "packages/config/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=veritio",
    "dev:all": "turbo run dev --filter=veritio",
    "dev:veritio": "turbo run dev --filter=veritio",
    "dev:landing": "turbo run dev --filter=landing",
    "build": "echo 'Skipping build for Railway backend deployment'",
    "build:full": "turbo run build",
    "build:veritio": "turbo run build --filter=veritio",
    "build:landing": "turbo run build --filter=landing",
    "start": "cd apps/veritio && ./start.sh",
    "start:backend": "cd apps/veritio && ./start.sh",
    "start:yjs": "cd apps/veritio && node scripts/yjs-server/server.ts",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:vitest": "turbo run test:vitest",
    "type-check": "turbo run type-check",
    "audit:security": "bun scripts/audit-security.ts",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:build": "rm -rf apps/*/.next apps/*/dist dist reports *.tsbuildinfo packages/**/*.tsbuildinfo",
    "clean:all": "bun run clean:build && bun run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.12"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "date-fns": "^4.4.0",
    "react-day-picker": "^9.14.0"
  },
  "overrides": {
    "path-to-regexp": ">=8.4.0",
    "@ai-sdk/provider-utils": "4.0.33",
    "@babel/core": ">7.29.0",
    "@hono/node-server": "1.19.15",
    "@humanfs/node": ">=0.16.8",
    "@isaacs/brace-expansion": "5.0.1",
    "ajv": ">=6.14.0 <7",
    "basic-ftp": "5.3.1",
    "better-auth": "1.6.31",
    "body-parser": ">=2.3.0",
    "brace-expansion": ">=1.1.17",
    "browserslist": "4.28.9",
    "defu": "6.1.7",
    "dompurify": "3.4.15",
    "fast-uri": "3.1.7",
    "fast-xml-parser": "5.11.1",
    "flatted": "3.4.4",
    "form-data": "4.0.6",
    "follow-redirects": ">1.15.11",
    "fflate": ">=0.8.3",
    "hono": "4.13.7",
    "ip-address": "10.7.0",
    "js-yaml": "4.3.2",
    "kysely": "0.28.17",
    "linkify-it": "5.0.2",
    "lodash": "4.18.1",
    "minimatch": ">=3.1.3",
    "nanoid": "5.1.16",
    "next": "16.3.5",
    "postcss": "8.5.28",
    "postcss-selector-parser": ">=7.1.3",
    "picomatch": ">=4.0.4",
    "protobufjs": "7.6.6",
    "qs": ">=6.16.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "rollup": "4.63.2",
    "sharp": "0.35.4",
    "shell-quote": "1.10.0",
    "uuid": ">=11.1.1",
    "ws": "8.21.3"
  }
}
